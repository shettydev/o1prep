# Copy this file to .env and fill in your values.

# --- Database (PostgreSQL) ---
# Start a local Postgres with: docker compose up -d
# The default below matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://o1prep:o1prep@localhost:5433/o1prep

# Secret key for signed session cookies. Generate a strong value for any real
# deployment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me

# AI engine for text interviews, the tutor, and voice mode:
#   claude      -> uses your local Claude Code CLI and existing login (no API key)
#   openai      -> uses the OpenAI API (requires OPENAI_API_KEY below)
#   openrouter  -> uses openrouter.ai; one key unlocks many models (see below)
AI_PROVIDER=claude

# --- Claude engine (AI_PROVIDER=claude) ---
# Requires Claude Code installed and signed in: run `claude` once in a terminal.
# Optional overrides:
# CLAUDE_MODEL=sonnet
# CLAUDE_BIN=claude
# CLAUDE_TIMEOUT=180

# --- OpenAI (AI_PROVIDER=openai) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# --- OpenRouter (AI_PROVIDER=openrouter) ---
# One key for many models (Anthropic, OpenAI, Google, Meta, ...).
# Get a key at https://openrouter.ai/keys and browse slugs at
# https://openrouter.ai/models. Voice mode's STT -> LLM -> TTS pipeline uses
# this same provider, so voice runs through OpenRouter when it's selected.
OPENROUTER_API_KEY=your-openrouter-key-here
# Optional overrides:
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_SITE_URL=https://your-deployment.example.com
# OPENROUTER_SITE_NAME=O(1) Prep

# --- Voice mode ---
# Speech-to-text and text-to-speech run in the browser (Web Speech API), so no
# extra keys are needed. The spoken interview is powered by AI_PROVIDER above.
# The legacy OpenAI Realtime path (routes/realtime.py) still requires
# OPENAI_API_KEY if you use it instead.

# --- Code execution (multi-language) ---
# Python runs via the app's interpreter. JavaScript needs Node.js and TypeScript
# needs a TS runner; override these only if they are not on PATH.
# NODE_BIN=node
# TS_CMD=tsx
