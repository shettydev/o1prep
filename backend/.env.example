# Copy this file to .env and fill in your values.

# --- Database (PostgreSQL) ---
# Start a local Postgres with: docker compose up -d
# The default below matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://o1prep:o1prep@localhost:5433/o1prep

# Secret key for signed session cookies. Generate a strong value for any real
# deployment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me

# AI engine for text interviews and the tutor:
#   claude  -> uses your local Claude Code CLI and existing login (no API key)
#   openai  -> uses the OpenAI API (requires OPENAI_API_KEY below)
AI_PROVIDER=claude

# --- Claude engine (AI_PROVIDER=claude) ---
# Requires Claude Code installed and signed in: run `claude` once in a terminal.
# Optional overrides:
# CLAUDE_MODEL=sonnet
# CLAUDE_BIN=claude
# CLAUDE_TIMEOUT=180

# --- OpenAI (AI_PROVIDER=openai, and always required for Voice mode) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# --- Code execution (multi-language) ---
# Python runs via the app's interpreter. JavaScript needs Node.js and TypeScript
# needs a TS runner; override these only if they are not on PATH.
# NODE_BIN=node
# TS_CMD=tsx
