{
  "name": "codeprep-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Repo-root dev tooling: Git pre-commit hooks that format staged files (Prettier for frontend, ruff for backend).",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "start": "pnpm --filter frontend start",
    "lint": "pnpm --filter frontend lint",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,js,jsx,mjs,cjs,css,json,md}\"",
    "format:py": "ruff check --fix backend/ && ruff format backend/",
    "format:all": "pnpm run format && pnpm run format:py"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx,mjs,cjs,css,json,md}": "prettier --write",
    "backend/**/*.py": [
      "ruff check --fix --force-exclude",
      "ruff format --force-exclude"
    ]
  }
}
